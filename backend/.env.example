ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/access_dashboard
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# common = work + personal Microsoft accounts; consumers = personal only
ENTRA_TENANT_ID=common
SESSION_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173
# Production public URL. On Render, set this to the Cloudflare hostname once the
# custom domain is live (e.g. https://access.example.com). Until then Render
# injects RENDER_EXTERNAL_URL and that stays the OIDC issuer / callback base.
# PUBLIC_BASE_URL=https://access.example.com
